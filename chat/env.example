# Se copia a ~/jarvis-chat/.env en `caja` y se rellena. NO se versiona relleno.

# El mismo valor que JARVIS_CLAUDE_TOKEN en backend/.env: es con lo que el backend entra.
JARVIS_CLAUDE_TOKEN=
# Dónde está /mcp/chat del backend, visto desde `caja`: el puerto que publica su
# contenedor (está en el compose del repositorio HomeLab), no la URL pública, que daría
# la vuelta por el túnel para volver a la misma máquina.
JARVIS_MCP_URL=http://127.0.0.1:8000/mcp/chat
# El mismo valor que JARVIS_MCP_CHAT_TOKEN en backend/.env.
JARVIS_MCP_CHAT_TOKEN=
# Ruta absoluta de la CLI (`which claude`): systemd no carga tu PATH.
CLAUDE_BIN=
JARVIS_CLAUDE_MODELO=claude-sonnet-5-5
# El único otro que se acepta: el que pide la «potencia máxima» de la vista de Jarvis.
JARVIS_CLAUDE_MODELO_POTENTE=claude-opus-5-5
# Dónde escucha. El backend corre en Docker, así que 127.0.0.1 no le vale: la IP del
# puente de Docker (`ip -4 addr show docker0`, normalmente 172.17.0.1) deja entrar al
# contenedor sin abrirlo a la red de casa.
JARVIS_CLAUDE_HOST=172.17.0.1
JARVIS_CLAUDE_PUERTO=3340
