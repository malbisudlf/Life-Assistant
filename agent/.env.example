# Life Assistant — Agente PC
# Copia este archivo como .env y rellena los valores

# Token de servicio con el que el agente habla con el backend: el MISMO valor que la
# variable AGENT_TOKEN del backend. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# No caduca — a diferencia del JWT del dashboard, que dura 30 días y dejaba al agente
# recibiendo 401 y cerrándose en silencio ("No hay jobs pendientes") en cada arranque.
AGENT_TOKEN=

# Respaldo solo para instalaciones sin AGENT_TOKEN: el JWT del dashboard (DevTools →
# Application → Local Storage → la_token). CADUCA A LOS 30 DÍAS; el agente lo avisa.
LA_TOKEN=

# Backend
LA_API_BASE=https://backend-tender-glow-160.fly.dev

# Anthropic
ANTHROPIC_API_KEY=

# Cuenta de Google/Deusto con la que se entra en Alud. Ya no la usa el agente para
# pulsar nada: viaja dentro de la instrucción que recibe Claude, para que sepa cuál
# elegir si se encuentra la pantalla de inicio de sesión en vez de la entrega.
ALUD_ACCOUNT=tu.nombre@opendeusto.es

# Los dos clics que llevan a Cowork en Claude Desktop, en fracción de pantalla (0-1).
# Claude Desktop no tiene atajo de teclado para cambiar de sección, así que hay que
# pinchar. Solo hace falta tocarlos si la app mueve el compositor de sitio: el primero
# es «New» en la barra lateral y el segundo, «Cowork» en el selector del compositor.
COWORK_NEW_X=0.0219
COWORK_NEW_Y=0.0757
COWORK_TOGGLE_X=0.4629
COWORK_TOGGLE_Y=0.4431

# Hosts (separados por comas) a los que el agente puede navegar al resolver una entrega.
# Debe coincidir con ALUD_ALLOWED_HOSTS del backend. Se comprueba también aquí porque un
# payload puede llegar a la tabla `jobs` sin haber pasado por el backend.
ALUD_ALLOWED_HOSTS=alud.deusto.es

# ── Streaming (Apollo + VPN) ─────────────────────────────────────────────────
# El host es Apollo (fork de Sunshine) y el cliente del móvil, Artemis (fork de
# Moonlight). Las variables SUNSHINE_* siguen valiendo como respaldo: si están
# puestas y no hay APOLLO_*, el agente las usa igual.
#
# Servicio de Windows del host de streaming. Es la vía principal: al agente lo lanza
# el Programador de tareas, que no corre en el escritorio del usuario, y un
# sunshine.exe arrancado desde ahí se cierra al instante. El servicio sabe meterlo
# en la sesión interactiva. Igual que Tailscale, se deja en arranque MANUAL.
# En blanco = se prueban ApolloService y SunshineService, en ese orden.
APOLLO_SERVICIO=ApolloService

# Ruta al host de streaming. Solo se usa como respaldo si no hay servicio registrado
# (instalaciones portables). En blanco = se busca en las rutas estándar de Apollo y
# Sunshine (Apollo conserva el nombre del binario original: sunshine.exe).
APOLLO_EXE=

# Segundos máximo esperando a que Apollo quede corriendo (si no, el job falla)
APOLLO_TIMEOUT=30

# VPN con la que el móvil llega al PC desde fuera de casa. El PC arranca por WOL
# sin VPN levantada, así que el job de streaming la conecta antes de abrir Apollo.
#   auto      → usa Tailscale si está instalado (por defecto)
#   tailscale → lo exige: si falta, avisa en el modal del dashboard
#   ninguna   → salta el paso (solo LAN)
VPN_TIPO=auto

# Ruta a tailscale.exe (en blanco = rutas estándar de Windows)
TAILSCALE_EXE=

# Servicio de Windows de Tailscale. Se deja en arranque MANUAL (así en el día a día
# el PC no tiene la VPN encendida) y lo arranca el agente cuando pides streaming;
# para eso la tarea del Programador necesita "privilegios más altos".
TAILSCALE_SERVICIO=Tailscale

# Segundos máximo esperando a que el túnel quede levantado
VPN_TIMEOUT=60

# ── Pantallas mientras se streamea ───────────────────────────────────────────
# Por Artemis se ve UNA sola pantalla: con el escritorio extendido, lo que Windows
# abra en el otro monitor queda fuera de alcance desde fuera de casa (no puedes
# arrastrar una ventana a un monitor que el stream no manda). Por eso el job de
# streaming pone Windows en DUPLICAR antes de abrir Apollo.
#   clone    → duplicar (por defecto)
#   extend   → extender
#   internal → solo la pantalla principal
#   external → solo la segunda
#   ninguna  → el agente no toca las pantallas
PANTALLAS_STREAMING=clone

# El modo al que se vuelve con `agent.py --pantallas` (sin argumento). El agente es
# efímero y no puede deshacerlo él al cerrar el stream: lo dispara Home Assistant
# antes de apagar o suspender el PC, y TIENE que ir por la tarea del Programador
# (`schtasks /run /tn LifeAssistantPantallas`), no por SSH — lo que entra por SSH
# corre en la sesión 0, sin escritorio, y ahí DisplaySwitch no hace nada y no falla.
PANTALLAS_RESTAURAR=extend

# Ruta a DisplaySwitch.exe (en blanco = %SystemRoot%\System32\DisplaySwitch.exe).
# Viene con Windows: es el propio conmutador de Win+P, no hay nada que instalar.
DISPLAYSWITCH_EXE=
