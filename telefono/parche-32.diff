diff -ruN a/voice-app/lib/conversacion-tercero.js b/voice-app/lib/conversacion-tercero.js
--- a/voice-app/lib/conversacion-tercero.js	1970-01-01 01:00:00.000000000 +0100
+++ b/voice-app/lib/conversacion-tercero.js	2026-11-01 11:20:21.130988100 +0100
@@ -0,0 +1,205 @@
+/**
+ * Parche 32: la conversación de Jarvis con OTRA persona (llamar_a_alguien).
+ * Ver telefono/PARCHES.md y docs/LLAMADAS_TERCEROS.md en Life Assistant.
+ *
+ * No es la conversación de siempre (conversation-loop.js), a propósito:
+ *   - **El cerebro es el backend, no Claude Code.** Cada frase del otro va a
+ *     `POST /telefono/tercero/{id}/turno`, que la piensa con un modelo SIN herramientas.
+ *     El Claude de claude-api-server tiene shell en caja: lo que diga un desconocido por
+ *     teléfono no puede llegar a él.
+ *   - **Sin pitidos, sin música de espera, sin «Un momento, señor».** Eso es para Mikel;
+ *     a un amigo suyo le suena a centralita.
+ *   - **Primero contesta él.** Quien coge dice «¿Sí?»: se le deja decirlo (hasta
+ *     ESPERA_SALUDO_MS) y entonces Jarvis se presenta. Hablar nada más descolgar pisa el
+ *     «¿Diga?» y lo primero que oye es media frase.
+ *   - Nada de lectura, confirmaciones ni escucha pasiva: aquí no hay nada de eso que hacer.
+ */
+
+const { decirInterrumpible } = require('./turno-rapido');
+const { armarAnticipo, transcribirFrase } = require('./anticipo');
+
+const ESPERA_SALUDO_MS = 4000;
+const ESPERA_TURNO_MS = 15000;
+const TURNOS_MAX = 20;
+const PREGUNTA_BACKEND_MS = 15000;
+// Lo más que se espera a FreeSWITCH al cerrar el audio: con la llamada ya colgada,
+// forkAudioStop puede no contestar nunca (EPIPE) y dejar la conversación sin terminar.
+const CIERRE_MS = 2000;
+
+const FRASES = {
+  hola: '¿Hola? ¿Me oyes?',
+  repite: 'Perdona, no te he entendido bien. ¿Me lo repites?',
+  fallo: 'Perdona, se me ha cortado algo por aquí. Mikel te escribirá. ¡Hasta luego!',
+  tope: 'Bueno, te dejo, que se lo cuento a Mikel. ¡Hasta luego!'
+};
+
+function backendUrl() {
+  return (process.env.LECTURA_URL || 'http://127.0.0.1:8080').replace(/\/+$/, '');
+}
+
+/**
+ * Lo que contesta Jarvis a lo que ha dicho el otro: {decir, colgar}. Si el backend no
+ * contesta, la despedida y colgar: una llamada a un tercero sin cerebro no se alarga.
+ */
+async function preguntarAlBackend(tercero, dicho, opciones) {
+  const fetchFn = (opciones && opciones.fetch) || fetch;
+  const ctl = new AbortController();
+  const vigia = setTimeout(function () { ctl.abort(); }, PREGUNTA_BACKEND_MS);
+  try {
+    const r = await fetchFn(backendUrl() + '/telefono/tercero/' + encodeURIComponent(tercero) + '/turno', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json',
+                 'X-Auth-Token': process.env.TELEFONO_TERCEROS_TOKEN || '' },
+      body: JSON.stringify({ dicho: String(dicho || '').slice(0, 2000) }),
+      signal: ctl.signal
+    });
+    if (!r.ok) throw new Error('backend ' + r.status);
+    const d = await r.json();
+    const decir = String((d && d.decir) || '').trim();
+    if (!decir) throw new Error('respuesta vacía');
+    return { decir: decir, colgar: Boolean(d.colgar) };
+  } catch (e) {
+    if (opciones && opciones.log) opciones.log('TERCERO: el backend no contestó (' + e.message + ')');
+    return { decir: FRASES.fallo, colgar: true, fallo: true };
+  } finally {
+    clearTimeout(vigia);
+  }
+}
+
+/**
+ * @param {Object} endpoint - FreeSWITCH
+ * @param {Object} dialog   - drachtio
+ * @param {string} callId
+ * @param {Object} o
+ * @param {Object} o.audioForkServer
+ * @param {Object} o.whisperClient
+ * @param {Object} o.ttsService
+ * @param {number} o.wsPort
+ * @param {string} o.tercero    - el id de la llamada en el backend
+ * @param {string} o.apertura   - la presentación («Hola, Erik. Soy Jarvis…»)
+ * @param {Promise<string>} [o.aperturaUrl] - la presentación ya pedida a la voz mientras
+ *   sonaba; si falla (null), se pide aquí
+ * @param {string} [o.voiceId]
+ * @param {Function} [o.onTurno] - (quien, texto) por cada frase, para GET /api/call
+ * @param {Function} [o.onUserTurn]
+ * @param {Function} [o.log]
+ * @param {Function} [o.fetch]
+ * @returns {Promise<{endReason: string}>} 'goodbye', 'silence', 'hangup', 'max_turns',
+ *   'no_audio' o 'error'
+ */
+async function runConversacionTercero(endpoint, dialog, callId, o) {
+  const log = o.log || function () {};
+  const voiceId = o.voiceId || null;
+  let activa = true;
+  const alColgar = function () { activa = false; };
+  dialog.on('destroy', alColgar);
+  let session = null;
+  let fork = false;
+  let desarmar = function () {};
+  let fin = 'max_turns';
+
+  const decir = async function (texto, previa) {
+    if (o.onTurno) o.onTurno('jarvis', texto);
+    const url = (previa && await previa) || await o.ttsService.generateSpeech(texto, voiceId);
+    if (!activa) return false;
+    return decirInterrumpible(endpoint, session, url, log);
+  };
+
+  try {
+    const esperada = o.audioForkServer.expectSession(callId, { timeoutMs: 10000 });
+    await endpoint.forkAudioStart({
+      wsUrl: 'ws://127.0.0.1:' + o.wsPort + '/' + encodeURIComponent(callId),
+      mixType: 'mono',
+      sampling: '16k'
+    });
+    fork = true;
+    try {
+      session = await esperada;
+    } catch (e) {
+      log('TERCERO: sin audio (' + e.message + ')');
+      fin = 'no_audio';
+      return { endReason: fin };
+    }
+    desarmar = armarAnticipo(session, o.whisperClient);
+
+    // El «¿Sí?» del otro: se espera, se transcribe y va con la presentación.
+    session.setCaptureEnabled(true);
+    let saludo = null;
+    try {
+      saludo = await session.waitForUtterance({ timeoutMs: ESPERA_SALUDO_MS });
+    } catch (e) { /* no ha dicho nada: Jarvis empieza igual */ }
+    session.setCaptureEnabled(false);
+    if (!activa) { fin = 'hangup'; return { endReason: fin }; }
+    if (saludo) {
+      const t = await transcribirFrase(o.whisperClient, saludo, log).catch(function () { return ''; });
+      if (t && t.trim()) {
+        if (o.onTurno) o.onTurno('otro', t.trim());
+        if (o.onUserTurn) o.onUserTurn(t.trim());
+      }
+    }
+
+    let interrumpio = await decir(o.apertura, o.aperturaUrl);
+    let silencios = 0;
+    let turnos = 0;
+
+    while (activa && turnos < TURNOS_MAX) {
+      turnos++;
+      if (!interrumpio) session.setCaptureEnabled(true);
+      interrumpio = false;
+      let frase = null;
+      try {
+        frase = await session.waitForUtterance({ timeoutMs: ESPERA_TURNO_MS });
+      } catch (e) { /* silencio */ }
+      session.setCaptureEnabled(false);
+      if (!activa) break;
+
+      if (!frase) {
+        silencios++;
+        if (silencios >= 2) { fin = 'silence'; break; }
+        interrumpio = await decir(FRASES.hola);
+        continue;
+      }
+      silencios = 0;
+
+      const dicho = String(await transcribirFrase(o.whisperClient, frase, log).catch(function () { return ''; }) || '').trim();
+      if (!activa) break;
+      if (dicho.length < 2) {
+        interrumpio = await decir(FRASES.repite);
+        continue;
+      }
+      log('TERCERO: oído «' + dicho.slice(0, 80) + '»');
+      if (o.onTurno) o.onTurno('otro', dicho);
+      if (o.onUserTurn) o.onUserTurn(dicho);
+
+      const r = await preguntarAlBackend(o.tercero, dicho, { log: log, fetch: o.fetch });
+      if (!activa) break;
+      if (r.colgar) {
+        // La despedida entera: si le corta, ya se ha despedido él.
+        await decir(r.decir);
+        fin = r.fallo ? 'error' : 'goodbye';
+        break;
+      }
+      interrumpio = await decir(r.decir);
+    }
+
+    if (activa && turnos >= TURNOS_MAX && fin === 'max_turns') await decir(FRASES.tope);
+    if (!activa && fin !== 'silence' && fin !== 'goodbye') fin = 'hangup';
+  } catch (e) {
+    log('TERCERO: fallo en la conversación (' + e.message + ')');
+    fin = 'error';
+  } finally {
+    dialog.off('destroy', alColgar);
+    desarmar();
+    if (session) session.setCaptureEnabled(false);
+    if (o.audioForkServer.cancelExpectation) o.audioForkServer.cancelExpectation(callId);
+    if (fork) {
+      try {
+        await Promise.race([endpoint.forkAudioStop(),
+                            new Promise(function (r) { setTimeout(r, CIERRE_MS); })]);
+      } catch (e) { /* ya parado */ }
+    }
+  }
+  return { endReason: fin };
+}
+
+module.exports = { runConversacionTercero, preguntarAlBackend, FRASES };
diff -ruN a/voice-app/lib/linea-o2.js b/voice-app/lib/linea-o2.js
--- a/voice-app/lib/linea-o2.js	1970-01-01 01:00:00.000000000 +0100
+++ b/voice-app/lib/linea-o2.js	2026-11-01 11:20:21.111336900 +0100
@@ -0,0 +1,199 @@
+/**
+ * Parche 32: la línea fija de casa (O2/Telefónica) por SIP, para que Jarvis llame a
+ * otras personas. Ver telefono/PARCHES.md y docs/LLAMADAS_TERCEROS.md en Life Assistant.
+ *
+ * El router de O2 registra la línea en un proxy SIP de Telefónica que se alcanza desde la
+ * LAN, y ese proxy acepta también el registro de `caja` con el mismo usuario y sin
+ * contraseña (probado el 2026-10-31). Lo que se sabe y lo que no:
+ *
+ *   - **El registro se hace solo para llamar, y se quita al colgar.** Mientras `caja` está
+ *     registrada, una llamada al fijo suena aquí además de en el Gigaset del router. Se
+ *     rechaza (`esSuya` + 480 en index.js), pero mejor que ni llegue: por eso no se queda
+ *     registrada de fondo.
+ *   - **Al quitarlo se quita SOLO nuestro Contact**, nunca `Contact: *`: el asterisco
+ *     borraría también el registro del router y el fijo dejaría de recibir llamadas.
+ *   - Que el INVITE necesite el registro previo es la hipótesis más fuerte (el primero, sin
+ *     registro, dio 403; tras registrar, sonó), no algo demostrado. Registrar antes es
+ *     inofensivo, así que se hace.
+ *   - Nada personal aquí: el usuario de la línea y la dirección del proxy van en el .env
+ *     (`O2_SIP_USUARIO`, `O2_PROXY`). El usuario no se escribe nunca en el log.
+ */
+
+const DOMINIO_DEFECTO = 'telefonica.net';
+const REFRESCO_MIN_SEG = 20;
+// Lo que Telefónica da a la línea (el router se registra cada 70 s). Si el 200 OK no dice
+// cuánto nos concede, se supone esto y no lo pedido: renovar a destiempo deja la línea
+// sin registro a mitad de una llamada.
+const CONCEDIDO_SI_NO_DICE = 70;
+
+class LineaO2 {
+  /**
+   * @param {Object} srf - drachtio SRF
+   * @param {Object} o
+   * @param {string} o.usuario   - el Auth Username del router (O2_SIP_USUARIO)
+   * @param {string} o.proxy     - "ip:puerto" del proxy SIP (O2_PROXY)
+   * @param {string} [o.dominio] - telefonica.net
+   * @param {string} o.ipLocal   - la IP de caja en la LAN (la de drachtio)
+   * @param {number} o.puertoLocal - el puerto SIP de drachtio (5070)
+   * @param {number} [o.expira]  - segundos que se piden al registrar
+   * @param {Function} [o.log]
+   */
+  constructor(srf, o) {
+    o = o || {};
+    this.srf = srf;
+    this.usuario = String(o.usuario || '').trim();
+    this.proxy = String(o.proxy || '').trim();
+    this.dominio = o.dominio || DOMINIO_DEFECTO;
+    this.ipLocal = o.ipLocal;
+    this.puertoLocal = o.puertoLocal || 5070;
+    this.expira = o.expira || 120;
+    this.log = o.log || function () {};
+    this.usos = 0;
+    this.registrada = false;
+    this.temporizador = null;
+    this.pendiente = null;
+  }
+
+  configurada() {
+    return Boolean(this.usuario && /^[\d.]+:\d+$/.test(this.proxy) && this.ipLocal);
+  }
+
+  ipProxy() {
+    return this.proxy.split(':')[0];
+  }
+
+  /** La URI del destino tal como la aceptó Telefónica: sip:+34…@telefonica.net:5060. */
+  destino(e164) {
+    return 'sip:' + e164 + '@' + this.dominio + ':5060';
+  }
+
+  cabeceras(e164) {
+    const yo = '"' + this.usuario + '" <sip:' + this.usuario + '@' + this.dominio + ':5070>';
+    const h = {
+      'From': yo,
+      'Contact': '<' + this.contacto() + '>',
+      'Route': '<sip:' + this.proxy + ';lr>',
+      'User-Agent': 'Jarvis-LA/1.0'
+    };
+    if (e164) h['To'] = '<' + this.destino(e164) + '>';
+    else h['To'] = yo;
+    return h;
+  }
+
+  contacto() {
+    return 'sip:' + this.usuario + '@' + this.ipLocal + ':' + this.puertoLocal + ';transport=udp';
+  }
+
+  /** Si un INVITE entrante viene del proxy de O2 (una llamada al fijo). */
+  esSuya(req) {
+    if (!this.configurada() || !req) return false;
+    return req.source_address === this.ipProxy();
+  }
+
+  /**
+   * Pide la línea para una llamada. La primera petición registra; las siguientes, si
+   * llegara a haber dos a la vez, reutilizan el registro. Lanza si no se registra.
+   */
+  async usar() {
+    if (!this.configurada()) throw new Error('linea_o2_sin_configurar');
+    this.usos++;
+    try {
+      if (!this.registrada) await this._registrar(this.expira);
+    } catch (e) {
+      this.usos--;
+      throw e;
+    }
+  }
+
+  /** Devuelve la línea. Con el último uso, quita el registro. Nunca lanza. */
+  async soltar() {
+    this.usos = Math.max(0, this.usos - 1);
+    if (this.usos > 0) return;
+    if (this.temporizador) clearTimeout(this.temporizador);
+    this.temporizador = null;
+    if (!this.registrada) return;
+    this.registrada = false;
+    try {
+      await this._registrar(0);
+      this.log('O2: registro quitado');
+    } catch (e) {
+      this.log('O2: no se pudo quitar el registro (' + e.message + '); caduca solo');
+    }
+  }
+
+  _registrar(segundos) {
+    if (this.pendiente && segundos > 0) return this.pendiente;
+    const h = this.cabeceras(null);
+    h['Contact'] = '<' + this.contacto() + '>;expires=' + segundos;
+    h['Expires'] = String(segundos);
+    h['Allow'] = 'INVITE, ACK, CANCEL, BYE, OPTIONS, INFO, UPDATE';
+    h['Supported'] = 'path, gruu';
+    const self = this;
+    const promesa = new Promise(function (resolver, rechazar) {
+      const vigia = setTimeout(function () { rechazar(new Error('o2_register_timeout')); }, 8000);
+      try {
+        self.srf.request('sip:' + self.dominio, {
+          method: 'REGISTER',
+          proxy: 'sip:' + self.proxy,
+          headers: h
+        }, function (err, req) {
+          if (err) { clearTimeout(vigia); rechazar(err); return; }
+          req.on('response', function (res) {
+            if (res.status < 200) return;
+            clearTimeout(vigia);
+            if (res.status !== 200) {
+              rechazar(new Error('o2_register_' + res.status));
+              return;
+            }
+            resolver(res);
+          });
+        });
+      } catch (e) {
+        clearTimeout(vigia);
+        rechazar(e);
+      }
+    }).then(function (res) {
+      if (segundos > 0) {
+        self.registrada = true;
+        const concedido = self._concedido(res, segundos);
+        self.log('O2: registrada (' + concedido + ' s)');
+        self._programarRefresco(concedido);
+      }
+      return res;
+    });
+    if (segundos > 0) {
+      this.pendiente = promesa;
+      promesa.then(function () { self.pendiente = null; }, function () { self.pendiente = null; });
+    }
+    return promesa;
+  }
+
+  /** Los segundos concedidos a NUESTRO Contact (Telefónica devuelve también los demás);
+   *  si no lo dice ahí, la cabecera Expires; si tampoco, CONCEDIDO_SI_NO_DICE. */
+  _concedido(res, pedido) {
+    const leer = function (h) { return (res && typeof res.get === 'function' && res.get(h)) || ''; };
+    const nuestro = String(leer('Contact')).split(/,(?=\s*<)/).find(function (c) {
+      return c.indexOf('@' + this.ipLocal + ':' + this.puertoLocal) >= 0;
+    }, this);
+    const m = nuestro && nuestro.match(/expires=(\d+)/i);
+    if (m) return parseInt(m[1], 10);
+    const cabecera = parseInt(leer('Expires'), 10);
+    if (cabecera > 0) return cabecera;
+    return Math.min(pedido, CONCEDIDO_SI_NO_DICE);
+  }
+
+  _programarRefresco(concedido) {
+    if (this.temporizador) clearTimeout(this.temporizador);
+    const self = this;
+    const seg = Math.max(REFRESCO_MIN_SEG, Math.floor(concedido * 0.6));
+    this.temporizador = setTimeout(function () {
+      if (self.usos <= 0) return;
+      self._registrar(self.expira).catch(function (e) {
+        self.log('O2: falló el refresco del registro (' + e.message + ')');
+      });
+    }, seg * 1000);
+    if (this.temporizador.unref) this.temporizador.unref();
+  }
+}
+
+module.exports = { LineaO2 };
