+function guardarToken(token) {
+  try {
+    fs.writeFileSync(FICHERO_TOKEN, JSON.stringify({ token: String(token) }), { mode: 0o600 });
+  } catch (e) {
+    console.warn('[TELE] No se pudo guardar el token: ' + e.message);
+  }
