+  if (NUMEROS[t] !== undefined) return NUMEROS[t];
+  const m = /^(veinti|treinta y |cuarenta y |cincuenta y )(\w+)$/.exec(t);
+  if (m && NUMEROS[m[2]] !== undefined) {
+    return ({ 'veinti': 20, 'treinta y ': 30, 'cuarenta y ': 40, 'cincuenta y ': 50 })[m[1]] + NUMEROS[m[2]];
