+  try {
+    const r = await pedirHttp({ port: 8001, path: '/api/v2/', method: 'GET' }, null, msTope || 2500);
+    const d = JSON.parse(r.cuerpo);
+    const p = String((d.device && d.device.PowerState) || 'on').toLowerCase();
