# La huella en jacobo: se copia como .env a ~/huella/servicio/ (chmod 600).
# La llave que mandará la voice-app en X-Auth-Token (HUELLA_VOZ_TOKEN allí). Sin ella,
# fuera de 127.0.0.1 el servicio no arranca. Genérala con: openssl rand -hex 32
HUELLA_TOKEN=
# Directorio con huella.onnx y media.npy (de banco.py, del MISMO modelo)
MODELO_DIR=
# Directorio donde se guarda la huella (huella.json y huella.anterior.json)
DATOS_DIR=
# Opcionales: HUELLA_UMBRAL (0.40), HUELLA_HILOS (2), HUELLA_MEDIA (/modelo/media.npy)
