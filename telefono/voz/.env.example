# El .env de la voz en jacobo (~/voz/servicio/.env, chmod 600). El de verdad no se versiona.

# La llave: sin ella no arranca escuchando fuera de local. `openssl rand -hex 32`
# El mismo valor va como VOZ_TOKEN en ~/.claude-phone/.env de caja.
VOZ_TOKEN=

# La voz que se usa si la petición no dice otra. Las que hay: GET /salud → voces
VOZ_POR_DEFECTO=piper:es_ES-davefx-medium

# Opcionales (valores por defecto en servidor.py)
# VOZ_HILOS=4
# VOZ_MAX_CHARS=600
# VOZ_CACHE_FRASES=64
