diff -ruN a/voice-app/lib/lectura.js b/voice-app/lib/lectura.js
--- a/voice-app/lib/lectura.js	1970-01-01 01:00:00.000000000 +0100
+++ b/voice-app/lib/lectura.js	2026-10-15 12:07:17.638554200 +0200
@@ -0,0 +1,135 @@
+/**
+ * Parche 18: leer en voz alta lo que no cabe en una respuesta. Ver
+ * telefono/PARCHES.md en Life Assistant.
+ *
+ * Cada respuesta de Claude por teléfono son 40 palabras (VOICE_CONTEXT, en
+ * claude-api-server) y lo que pase de 60 se tira (extractVoiceLine). El briefing de
+ * la mañana son ~15 minutos: Claude solo podía leer un trozo y preguntar «¿sigo?».
+ * Y aunque se le dejara, recitar 15.000 caracteres le llevaría más de un minuto de
+ * música de espera por turno.
+ *
+ * Así que Claude no lo lee. Pone en su respuesta una línea
+ *
+ *   📖 LEER: briefing [desde=N] [hasta=M] [fecha=YYYY-MM-DD]
+ *
+ * y la llamada pide el texto ya preparado para la voz al backend de Life Assistant
+ * (GET /telefono/briefing) y lo lee ella, trozo a trozo: mientras suena uno se
+ * sintetiza el siguiente, y cada trozo se puede cortar hablando (barge-in, parche
+ * 16). Si le cortas, a Claude le llega en qué sección iba, para seguir desde ahí.
+ *
+ * Variables: LECTURA_URL (por defecto http://127.0.0.1:8080, el backend en la misma
+ * máquina; la voice-app va con network_mode host) y LECTURA_TOKEN (el token del MCP
+ * del teléfono, JARVIS_MCP_TELEFONO_TOKEN del backend).
+ */
+'use strict';
+
+const { decirInterrumpible } = require('./turno-rapido');
+
+const MARCA = /📖\s*LEER:\s*briefing\b([^\n]*)/i;
+const NO_PUEDO = 'No he podido traer el briefing para leértelo.';
+
+/** El pedido de lectura que trae la respuesta de Claude, o null si no lo trae. */
+function pedidoDeLectura(respuesta) {
+  const m = String(respuesta || '').match(MARCA);
+  if (!m) return null;
+  const resto = m[1] || '';
+  const valor = function (clave, patron) {
+    const r = resto.match(new RegExp(clave + '\\s*=\\s*(' + patron + ')'));
+    return r ? r[1] : '';
+  };
+  return {
+    fecha: valor('fecha', '\\d{4}-\\d{2}-\\d{2}'),
+    desde: parseInt(valor('desde', '\\d+'), 10) || 1,
+    hasta: parseInt(valor('hasta', '\\d+'), 10) || 0
+  };
+}
+
+async function traerBriefing(pedido, fetchImpl) {
+  const base = (process.env.LECTURA_URL || 'http://127.0.0.1:8080').replace(/\/+$/, '');
+  const q = new URLSearchParams({ desde: String(pedido.desde), hasta: String(pedido.hasta) });
+  if (pedido.fecha) q.set('fecha', pedido.fecha);
+  try {
+    const r = await (fetchImpl || fetch)(base + '/telefono/briefing?' + q.toString(), {
+      headers: { Authorization: 'Bearer ' + (process.env.LECTURA_TOKEN || '') },
+      signal: AbortSignal.timeout(20000)
+    });
+    if (!r.ok) return { ok: false, frase: NO_PUEDO, motivo: 'HTTP ' + r.status };
+    const datos = await r.json();
+    if (!datos || !datos.ok) return { ok: false, frase: (datos && datos.frase) || NO_PUEDO };
+    return datos;
+  } catch (e) {
+    return { ok: false, frase: NO_PUEDO, motivo: e.message };
+  }
+}
+
+/**
+ * Si la respuesta pide leer, lee. Devuelve { interrumpio, aviso }: `interrumpio` como
+ * decirInterrumpible (el oído queda abierto con lo que estás diciendo), y `aviso`, lo
+ * que hay que anteponer a lo siguiente que se le pregunte a Claude ('' si nada).
+ *
+ * @param {string} respuesta - lo que contestó Claude
+ * @param {Object} c - { endpoint, session, ttsService, voiceId, log, sigueActiva, fetchImpl }
+ */
+async function leerSiLoPide(respuesta, c) {
+  const pedido = pedidoDeLectura(respuesta);
+  if (!pedido) return { interrumpio: false, aviso: '' };
+  const log = c.log || function () {};
+  const sigueActiva = c.sigueActiva || function () { return true; };
+  log('LECTURA: briefing desde=' + pedido.desde + ' hasta=' + (pedido.hasta || 'fin') +
+      (pedido.fecha ? ' fecha=' + pedido.fecha : ''));
+
+  const datos = await traerBriefing(pedido, c.fetchImpl);
+  if (!datos.ok) {
+    log('LECTURA: no se puede (' + (datos.motivo || datos.frase) + ')');
+    if (!sigueActiva()) return { interrumpio: false, aviso: '' };
+    const url = await c.ttsService.generateSpeech(datos.frase, c.voiceId);
+    const cortado = await decirInterrumpible(c.endpoint, c.session, url, log);
+    return { interrumpio: cortado,
+             aviso: '[La lectura del briefing no se pudo hacer: «' + datos.frase + '»] ' };
+  }
+
+  const cola = [];
+  for (const s of datos.secciones || []) {
+    for (const t of s.trozos || []) cola.push({ n: s.n, titulo: s.titulo, texto: t });
+  }
+  if (!cola.length) return { interrumpio: false, aviso: '' };
+  const total = (datos.secciones || []).length;
+  const ultima = cola[cola.length - 1].n;
+  cola.push({ n: ultima, titulo: cola[cola.length - 1].titulo, texto: 'Hasta aquí el briefing.' });
+
+  // El siguiente trozo se sintetiza mientras suena el actual: así no hay silencio entre
+  // uno y otro. Un fallo de la voz se guarda como null y corta la lectura ahí.
+  const sintetizar = function (texto) {
+    return c.ttsService.generateSpeech(texto, c.voiceId).catch(function (e) {
+      log('LECTURA: falló la voz (' + e.message + ')');
+      return null;
+    });
+  };
+  let siguiente = sintetizar(cola[0].texto);
+  for (let i = 0; i < cola.length; i++) {
+    if (!sigueActiva()) return { interrumpio: false, aviso: '' };
+    const url = await siguiente;
+    siguiente = i + 1 < cola.length ? sintetizar(cola[i + 1].texto) : null;
+    if (!url) {
+      return { interrumpio: false,
+               aviso: '[La lectura del briefing se cortó por un fallo de la voz en la sección ' +
+                      cola[i].n + ' («' + cola[i].titulo + '»). Dile dónde se quedó.] ' };
+    }
+    const cortado = await decirInterrumpible(c.endpoint, c.session, url, log);
+    if (cortado) {
+      if (siguiente) siguiente.catch(function () {});
+      log('LECTURA: cortada en la sección ' + cola[i].n);
+      return { interrumpio: true,
+               aviso: '[Le estabas leyendo el briefing y te ha cortado en la sección ' +
+                      cola[i].n + ' de ' + total + ' («' + cola[i].titulo + '»). Si te pide ' +
+                      'que sigas, vuelve a poner la línea 📖 LEER: briefing desde=' + cola[i].n +
+                      (pedido.fecha ? ' fecha=' + pedido.fecha : '') + '] ' };
+    }
+  }
+  log('LECTURA: terminada (' + (cola.length - 1) + ' trozos)');
+  return { interrumpio: false,
+           aviso: '[Ya le has leído el briefing entero (de la sección ' + pedido.desde +
+                  ' a la ' + ultima + ').] ' };
+}
+
+module.exports = { leerSiLoPide, pedidoDeLectura, traerBriefing };
