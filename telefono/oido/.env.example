# El .env del oído en jacobo (~/oido/servicio/.env, chmod 600). El de verdad no se versiona.

# La llave: sin ella no arranca escuchando fuera de local. `openssl rand -hex 32`
OIDO_TOKEN=

# Dónde están los modelos ggml en jacobo (ruta absoluta)
MODELOS=

# Los grupos que abren /dev/dri en jacobo: `getent group render video`
RENDER_GID=
VIDEO_GID=

# Opcionales (valores por defecto en servidor.py)
# OIDO_MODELO_RAPIDO=/modelos/ggml-small.bin
# OIDO_MODELO_FINAL=/modelos/ggml-large-v3-turbo-q5_0.bin
# OIDO_PASO_SEG=0.5
# OIDO_SILENCIO_RMS=150
