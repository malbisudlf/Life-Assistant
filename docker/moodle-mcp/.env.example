# Copia esto a .env (ignorado por git) en ~/docker/moodle-mcp/ de caja.

# La del SITIO, sin la ruta del servicio: servidor.py le añade /webservice/rest/server.php.
# La misma que MOODLE_URL en backend/.env.
MOODLE_URL=https://alud.deusto.es

# El token del servicio «Moodle mobile web service». Cómo sacarlo: docs/MOODLE.md.
# El mismo que MOODLE_TOKEN en backend/.env.
MOODLE_TOKEN=

# La llave de ESTE servidor: la que tiene que mandar Jarvis en `Authorization: Bearer`.
# Mínimo 32 caracteres; sin ella no arranca. Genérala con: openssl rand -hex 32
# Va también en JARVIS_MCP_SERVERS del backend, como "token" del servidor "moodle".
MOODLE_MCP_TOKEN=

# ── Para usarlo desde la app de Claude (web, escritorio, móvil) ─────────────────
# Vacío = solo LAN, que es lo que necesita Jarvis. La app de Claude llama desde los
# servidores de Anthropic, así que necesita una URL https pública (un hostname del
# Cloudflare Tunnel de caja apuntando a este puerto) e inicia sesión por OAuth. La URL
# del conector será esta misma terminada en /mcp. Ver docs/MOODLE.md.
# MOODLE_MCP_URL_PUBLICA=https://moodle.<tu dominio>

# La clave que pide la página de permiso al conectar la app de Claude. Mínimo 12
# caracteres; sin ella, con la URL pública puesta, no arranca.
# MOODLE_MCP_CLAVE=
