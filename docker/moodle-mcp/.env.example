# Copia esto a .env (ignorado por git) en ~/docker/moodle-mcp/ de caja.

# La del SITIO, sin la ruta del servicio: servidor.py le añade /webservice/rest/server.php.
# La misma que MOODLE_URL en backend/.env.
MOODLE_URL=https://alud.deusto.es

# El token del servicio «Moodle mobile web service». Cómo sacarlo: docs/MOODLE.md.
# El mismo que MOODLE_TOKEN en backend/.env.
MOODLE_TOKEN=

# La llave de ESTE servidor: la que tiene que mandar Jarvis en `Authorization: Bearer`.
# Mínimo 32 caracteres; sin ella no arranca. Genérala con: openssl rand -hex 32
# Va también en JARVIS_MCP_SERVERS del backend, como "token" del servidor "moodle".
MOODLE_MCP_TOKEN=
