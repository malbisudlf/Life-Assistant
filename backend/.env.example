# Life Assistant — configuración del backend
# Copia este archivo como backend/.env (local) o configúralo con `fly secrets set` (producción).
# Comprueba tu configuración con: python backend/check_config.py

# ── Obligatorias (el backend NO arranca sin ellas) ────────────────────────────
SECRET_KEY=                 # cadena larga y aleatoria; firma los JWT (openssl rand -hex 32)
DASHBOARD_PASSWORD=         # contraseña de acceso al dashboard (numérica: el input del login es numérico)

# ── Supabase (BD; obligatoria para casi todo) ─────────────────────────────────
SUPABASE_URL=               # https://xxxx.supabase.co
SUPABASE_KEY=               # service_role key (NUNCA la anon key)

# ── Microsoft Graph / Outlook (calendario) ────────────────────────────────────
CLIENT_ID=                  # app registrada en Azure AD (ver docs/DESPLIEGUE.md)
TENANT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/callback

# ── Servicios externos ────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=        # Distance Matrix (hora de salida con tráfico)
OPENAI_API_KEY=             # Whisper + GPT-4o-mini (ideas por voz). Opcional de verdad:
                            # sin ella el backend arranca y /ideas/* responde 503.

# ── Tokens de servicio (máquinas; genera valores aleatorios distintos) ───────
HA_POLL_TOKEN=              # Home Assistant sondea /ha/* con este token
HEALTH_INGEST_TOKEN=        # Health Auto Export / iOS Shortcuts envían salud con este token
BRIEF_TOKEN=                # el disparador diario llama a POST /brief/send con este token
                            # (secret BRIEF_TOKEN del repo, ver .github/workflows/resumen-diario.yml)

# ── Resumen diario por correo (POST /brief/send) ──────────────────────────────
# El backend manda los datos del día en crudo a tu propio buzón; de ahí los recoge la
# rutina que compone tu correo diario. No redacta nada: no hay llamadas a ningún LLM.
# Envío por SMTP con la librería estándar — sin dependencias ni servicios de terceros.
BRIEF_TO=                   # destinatario (tu propia dirección)
BRIEF_FROM=                 # remitente; si lo dejas vacío se usa SMTP_USER
SMTP_HOST=smtp.gmail.com    # con Gmail; cualquier SMTP vale
SMTP_PORT=587               # 587 = STARTTLS · 465 = TLS directo (SMTPS)
SMTP_USER=                  # tu dirección de correo
SMTP_PASSWORD=              # con Gmail y 2FA: una CONTRASEÑA DE APLICACIÓN, no la normal
                            # (https://myaccount.google.com/apppasswords)
ENTREGAS_MARKER=📚          # marcador que convierte un evento en "entrega".
                            # Debe coincidir con VITE_ENTREGAS_MARKER del frontend:
                            # el backend no ve las variables VITE_*.
# BRIEF_DIAS_ENTREGAS=14    # cuántos días de entregas próximas incluir en el correo

# ── Personalización de la instancia ───────────────────────────────────────────
TIMEZONE=Europe/Madrid      # zona horaria IANA del usuario
HOME_ADDRESS=               # origen por defecto para "¿a qué hora salir?" (tu dirección)
CLASSES_CALENDAR=clases     # nombre del calendario de clases en Outlook (vacío si no aplica)
CORS_ORIGINS=http://localhost:5173,https://TU-APP.vercel.app
WEATHER_LAT=40.4168         # coordenadas del widget de clima (Open-Meteo, sin API key)
WEATHER_LON=-3.7038         # por defecto Madrid — pon las tuyas
ALUD_ALLOWED_HOSTS=alud.deusto.es
                            # hosts (separados por comas) a los que se permite apuntar
                            # `alud_url`. Esa URL sale del cuerpo de un evento de Outlook
                            # y el agente la abre en un navegador CON SESIÓN INICIADA, así
                            # que solo se aceptan https y estos hosts (o sus subdominios).
                            # Pon el mismo valor en agent/.env.

# ── Opcionales ────────────────────────────────────────────────────────────────
# MAX_JOB_ATTEMPTS=3        # reintentos máximos de un job del agente PC
# LOGIN_MAX_ATTEMPTS=5      # rate limiting del login
# LOGIN_WINDOW_SECONDS=300
# LOGIN_BLOQUEO_MAX_SECONDS=3600   # techo del bloqueo progresivo (cada bloqueo dura el doble)
# HTTP_TIMEOUT=15           # segundos máx. por llamada saliente (Supabase, Graph, Maps)
# MAX_AUDIO_BYTES=8388608   # tope del audio de /ideas/audio (8 MB). Sin tope, el fichero
#                           # se carga entero en memoria y la VM tiene 1 GB.
# MAX_INGEST_BYTES=4194304  # tope del cuerpo de /health/ingest y /health/ingest/simple (4 MB)
# AUDIO_MAX_REQUESTS=10     # peticiones a /ideas/audio por IP y ventana: cada una es una
# AUDIO_WINDOW_SECONDS=300  # llamada de pago a Whisper
# TRUST_FORWARDED_FOR=      # ponlo a 1 SOLO si despliegas detrás de un proxy inverso
                            # propio que añada X-Forwarded-For. En Fly NO hace falta
                            # (ya manda Fly-Client-IP). Activarlo sin ese proxy delante
                            # permite falsificar la IP y saltarse el límite de intentos.
# HA_URL=                   # no lo usa el backend (HA sondea al backend, no al revés)
# HA_TOKEN=

# ── Registro persistente (tabla app_logs) ─────────────────────────────────────
# Los logger.error()/warning() del backend se guardan en Supabase además de salir por
# stdout, porque el stdout se va con la máquina de Fly cuando escala a cero. Se ven en
# ajustes → Estado del sistema → Registro.
# LOG_PERSIST=1             # ponlo a 0 para desactivarlo (solo stdout)
# LOG_PERSIST_LEVEL=WARNING # nivel mínimo que se persiste. INFO multiplica el volumen
#                           # y llena la tabla de ruido: sube a ERROR o baja con criterio
# LOG_QUEUE_MAX=500         # entradas encoladas en memoria como mucho. Al llenarse se
#                           # tiran las más viejas y se deja constancia de cuántas
# LOG_FLUSH_SECONDS=2       # cada cuánto vuelca el hilo de fondo
# LOG_RETENTION_DAYS=30     # se borra lo más viejo (una purga por arranque del proceso)
# LOG_SLOW_MS=8000          # a partir de aquí una petición se registra como lenta. Va
#                           # holgado: el arranque en frío de Fly ya se lleva segundos
