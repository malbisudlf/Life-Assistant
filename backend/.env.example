# Life Assistant — configuración del backend
# Copia este archivo como backend/.env (local) o configúralo con `fly secrets set` (producción).
# Comprueba tu configuración con: python backend/check_config.py

# ── Obligatorias (el backend NO arranca sin ellas) ────────────────────────────
SECRET_KEY=                 # cadena larga y aleatoria; firma los JWT (openssl rand -hex 32)
DASHBOARD_PASSWORD=         # contraseña de acceso al dashboard (numérica: el input del login es numérico)

# ── Supabase (BD; obligatoria para casi todo) ─────────────────────────────────
SUPABASE_URL=               # https://xxxx.supabase.co
SUPABASE_KEY=               # service_role key (NUNCA la anon key)

# ── Microsoft Graph / Outlook (calendario) ────────────────────────────────────
CLIENT_ID=                  # app registrada en Azure AD (ver docs/DESPLIEGUE.md)
TENANT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/callback

# ── Servicios externos ────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=        # Distance Matrix (hora de salida con tráfico)
OPENAI_API_KEY=             # Whisper + GPT-4o-mini (ideas por voz). Opcional de verdad:
                            # sin ella el backend arranca y /ideas/* responde 503.

# ── Tokens de servicio (máquinas; genera valores aleatorios distintos) ───────
HA_POLL_TOKEN=              # Home Assistant sondea /ha/* con este token
HEALTH_INGEST_TOKEN=        # Health Auto Export / iOS Shortcuts envían salud con este token
BRIEF_TOKEN=                # avisa de que te has despertado (POST /despertar, desde el
                            # Atajo del iPhone) y dispara la red de seguridad
                            # (POST /brief/send, secret BRIEF_TOKEN del repo)
AGENT_TOKEN=                # el agente PC sondea y cierra jobs con este token (mismo valor
                            # en agent/.env). Sin él el agente cae al JWT del dashboard, que
                            # caduca a los 30 días y lo deja mudo sin avisar.

# ── Resumen diario por correo (POST /brief/send) ──────────────────────────────
# El backend manda los datos del día en crudo a tu propio buzón; de ahí los recoge la
# rutina que compone tu correo diario. No redacta nada: no hay llamadas a ningún LLM.
# Envío por SMTP con la librería estándar — sin dependencias ni servicios de terceros.
BRIEF_TO=                   # destinatario (tu propia dirección)
BRIEF_FROM=                 # remitente; si lo dejas vacío se usa SMTP_USER
SMTP_HOST=smtp.gmail.com    # con Gmail; cualquier SMTP vale
SMTP_PORT=587               # 587 = STARTTLS · 465 = TLS directo (SMTPS)
SMTP_USER=                  # tu dirección de correo
SMTP_PASSWORD=              # con Gmail y 2FA: una CONTRASEÑA DE APLICACIÓN, no la normal
                            # (https://myaccount.google.com/apppasswords)
ENTREGAS_MARKER=📚          # marcador que convierte un evento en "entrega".
                            # Debe coincidir con VITE_ENTREGAS_MARKER del frontend:
                            # el backend no ve las variables VITE_*.
# BRIEF_DIAS_ENTREGAS=14    # cuántos días de entregas próximas incluir en el correo

# ── Economía en el resumen ────────────────────────────────────────────────────
# Dos secciones del correo que no salen de ningún sensor: un puñado de titulares de
# economía general y un término económico distinto cada día (interés compuesto, euríbor,
# tipo de interés...). Aquí solo se recogen en crudo; quien elige qué noticia cuenta y
# quien explica el término es la rutina que redacta el briefing.
# BRIEF_ECONOMIA=1          # 0 para quitar las dos secciones del correo
# BRIEF_ECONOMIA_FEEDS=     # feeds RSS/Atom separados por comas. Por defecto, tres
                            # secciones de economía de medios españoles. La elección de
                            # las fuentes es la única criba de relevancia que hay: si lo
                            # que llega no te toca, cambia la fuente, no hay filtro por
                            # palabras. Comprueba que responden mirando GET /brief: cada
                            # fuente sale con cuántos titulares aportó (0 = sospechosa).
# BRIEF_ECONOMIA_MAX=8      # cuántos titulares van en el correo como mucho
# BRIEF_ECONOMIA_HORAS=30   # antigüedad máxima de un titular. Más de 24 a propósito: con
                            # 24 justas, lo publicado ayer a la hora de tu correo no
                            # entra nunca. El solape lo limpia el descarte de los que ya
                            # salieron en el resumen anterior.

# ── Cuándo sale el correo ─────────────────────────────────────────────────────
# No sale a hora fija: sale cuando te despiertas. Avisan de eso el Atajo del iPhone
# (POST /despertar) y la llegada del sueño del Watch; si ninguno lo hace, el sondeo de
# HA (POST /ha/brief-tick) lo manda igual al llegar la hora tope. Todo pasa por la
# tabla brief_envios, que garantiza un solo correo al día por muchos que disparen.
# BRIEF_DESPERTAR_DESDE=05:30  # antes de esta hora local, una señal NO cuenta como
                               # despertarse (mirar el móvil de madrugada no vale)
# BRIEF_DESPERTAR_HASTA=11:30  # ni después de esta: una desconexión de media tarde no
                               # puede mandar el correo del día cuando ya no sirve
# BRIEF_HORA_TOPE=10:00        # si a esta hora nadie ha dado señal, se manda igual
# BRIEF_DISPARA_SUENO=1        # que la llegada del sueño del Watch cuente como señal.
                               # Es una deducción: ponlo a 0 si se adelanta porque el
                               # iPhone sincroniza noches a medias mientras duermes.

# ── Avisos al móvil (app companion de Home Assistant) ─────────────────────────
# El correo llega con la web cerrada, pero se lee al abrir el buzón. HA sondea
# /ha/avisos-pending y los manda al móvil; el backend NO sabe a qué dispositivo (eso
# es el notify.mobile_app_* del YAML de HA, ver docs/HOME_ASSISTANT_JARVIS.md).
# Mientras nadie sondee, todo sigue saliendo por correo: no hay nada que activar.
# AVISOS_MOVIL=1              # 0 fuerza el correo aunque HA esté recogiendo
# AVISO_MOVIL_VIVO=300        # segundos sin sondeo tras los que se vuelve al correo
# AVISO_MOVIL_RESCATE=600     # segundos que espera un aviso encolado antes de irse
                              # por correo (el YAML a medias no puede tragarse avisos)

# ── Vigilante de la ingesta de salud ──────────────────────────────────────────
# Nadie vigila el SILENCIO: las averías grandes de este proyecto (el 409 del upsert,
# el 400 del envoltorio) fueron datos que dejaron de llegar mientras todo respondía
# que iba bien. Esto lo mira en el mismo tick de HA. Si no se puede consultar, calla:
# "no he podido preguntar" no es "no ha llegado nada".
# INGESTA_VIGILAR=1            # 0 lo apaga y no cuesta ni una consulta
# INGESTA_AVISO_HORAS=24       # horas sin recibir nada a partir de las que se registra
# INGESTA_CORREO_HORAS=48      # y a partir de las que además avisa por correo
# INGESTA_VIGILA_CADA_MIN=60   # el tick pasa cada 5 min: solo se consulta una vez/hora

# ── Reglas proactivas ─────────────────────────────────────────────────────────
# Lo que Jarvis dice sin que le hablen. Cada regla es una condición cerrada sobre datos
# que ya existen; el listón está en el código, no en el criterio del modelo.
# REGLAS_PROACTIVAS=1          # 0 las apaga todas
# SALIR_VENTANA_MIN=180        # cuánto por delante se calcula la hora de salir
# SALIR_ANTES_MIN=10           # el aviso de "sal ya", X min antes de la hora de salir
# REGLAS_HORA_NOCHE=21:30      # las que miran lo de mañana (no llegas, madrugón, hueco)
# REGLAS_HORA_MANANA=08:00     # las que miran lo de hoy (firma de malestar)
# MADRUGON_HASTA=09:00         # antes de esta hora, mañana es un madrugón
# SUENO_OBJETIVO_H=7.5         # horas de sueño con las que se calcula la hora de dormir
# PREP_MANANA_MIN=60           # lo que tardas desde que suena el despertador
# HUECO_ENTRENO_MIN=90         # hueco mínimo para proponer entrenar
# PC_ENTIDAD=                  # entidad de HA del PC (p.ej. switch.pc). Vacío: la regla
#                              # de "te fuiste con el PC encendido" no corre. No se
#                              # adivina por el nombre: acabaría apagando otra cosa

# ── Vigilar páginas y correo entrante ─────────────────────────────────────────
# Vigilar una página es la capacidad proactiva GENÉRICA: en vez de una regla en el código
# por cada cosa, una que las cubre todas y que se crea hablando con Jarvis.
# VIGILANCIAS_MAX=5            # tope: cada una es una descarga por revisión
# VIGILANCIA_CADA_MIN=60       # cada cuánto se revisan
#
# El correo entrante saca lo ACCIONABLE CON FECHA del buzón (no lo resume: de eso ya se
# encarga la rutina del briefing). Apagado mientras no configures IMAP_HOST. Solo lee
# CABECERAS —asunto, remitente, fecha—, nunca el cuerpo; no marca nada como leído; y no
# guarda nada en la base de datos.
# IMAP_HOST=                   # p.ej. imap.gmail.com. Vacío = apagado
# IMAP_USER=                   # si lo dejas vacío se usa SMTP_USER
# IMAP_PASSWORD=               # con Gmail y 2FA, la misma contraseña de aplicación
# IMAP_CARPETA=INBOX
# CORREO_CADA_MIN=180          # cada cuánto se mira el buzón
# CORREO_HORAS=24              # ventana de correos sin leer que se examina
# CORREO_MAX=20                # cuántos como mucho

# ── Reglas que Jarvis propone y tú apruebas ───────────────────────────────────
# El modelo no escribe reglas: RELLENA plantillas que el código ya sabe evaluar
# (_PLANTILLAS_REGLA). El alta pasa por el botón de confirmar del dashboard.
# REGLAS_USUARIO_MAX=10        # cuántas puede tener a la vez
# RELOJ_AVISO_ANTES_MIN=60     # cuánto antes de tu hora habitual de dormirte sale
#                              # el aviso del reloj (la hora ya no es fija: se
#                              # aprende de tus propias noches)

# ── Gobierno de los avisos ────────────────────────────────────────────────────
# Un asistente proactivo tiene un solo modo de fallo: volverse ruido. Estas tres cosas
# son lo que impide que cada regla nueva sea un aviso más. Lo que pediste tú (recordarme)
# NO se gobierna: ni tope, ni silenciado.
# AVISOS_MAX_DIA=3             # avisos de regla al día; lo que no entra se pospone a
#                              # la mañana siguiente, no se pierde. Lo urgente se lo salta
# AVISOS_NO_UTILES=3           # "no útil" SEGUIDOS para que una regla se calle sola
# AVISOS_REPETIR_DIAS=5        # días sin repetir la misma situación
# AVISOS_HORA_DIFERIDOS=08:30  # a qué hora sale lo que ayer no entró en el presupuesto
# AVISOS_HORA_SILENCIO=22:00   # a partir de aquí, lo que puede esperar espera a mañana
# Lo que TÚ pides no se gobierna, y eso incluye las reglas que apruebas tú (`tuya:*`):
# ni gastan presupuesto ni se posponen. Antes sí, y una regla tuya de las 20:30 llegaba
# a las 08:30 del día siguiente.
#
# Y el retraso con el que sale un aviso se registra, porque un aviso que llega tarde y
# uno que se apuntó a la hora equivocada son indistinguibles después:
# AVISO_RETRASO_AVISA_MIN=15   # a partir de aquí, warning (el tick pasa cada 5 min)
# AVISO_RETRASO_AVERIA_MIN=60  # a partir de aquí, error: sale en el panel y en el vigilante

# ── Vigilante del sistema ─────────────────────────────────────────────────────
# El de arriba mira que sigan entrando datos de salud; este mira si algo más se está
# rompiendo: errores que se REPITEN en app_logs y el disparo de la rutina fallado (que
# además reintenta, porque su 2xx confirma el efecto). Lo que necesita un cambio de
# código no lo puede reparar nadie desde aquí: abre un issue en JARVIS_REPO si hay un
# servidor MCP de GitHub conectado, y solo la primera vez de cada avería.
# Necesita la migración 20260817_vigilante_estado; sin ella avisa igual, pero sin las
# cifras de "cuántas veces lleva" y sin abrir issues.
# VIGILANTE=1                  # 0 lo apaga y no cuesta ni una consulta
# VIGILANTE_CADA_MIN=60        # lee app_logs una vez por hora, no en cada tick
# VIGILANTE_MIN_ERRORES=3      # errores del mismo origen para considerarlo avería
# VIGILANTE_VENTANA_DIAS=1     # ventana de registro que mira
# VIGILANTE_ISSUES=1           # 0 deja el issue sin abrir (el aviso sale igual)

# ── Disparo de la rutina que redacta el briefing (opcional) ───────────────────
# La rutina de Claude Code que lee este correo admite un trigger de API además del de
# horario. Con estas variables, el backend la lanza en cuanto manda el correo de datos
# — pero solo a partir de BRIEF_RUTINA_DESDE: antes de esa hora se encarga el trigger
# de horario de la propia rutina, porque el briefing recoge newsletters que de
# madrugada aún no han llegado. Sin estas variables no se dispara nada y la rutina se
# queda solo con su horario.
# URL y token se generan en claude.ai/code/routines → editar la rutina → "Add another
# trigger" → API → "Generate token". El token SOLO se enseña una vez.
RUTINA_FIRE_URL=            # https://api.anthropic.com/v1/claude_code/routines/trig_.../fire
RUTINA_FIRE_TOKEN=          # sk-ant-oat01-... (da acceso a disparar ESA rutina y nada más)
# BRIEF_RUTINA_DESDE=08:00  # antes de esta hora dispara el trigger de horario, no el backend
# RUTINA_BETA=experimental-cc-routine-2026-04-01
                            # cabecera beta con fecha; el endpoint está en research
                            # preview. Si empieza a devolver 400, actualiza esto.

# ── La revisión nocturna, accionable (opcional) ───────────────────────────────
# De madrugada, una rutina de Claude Code revisa los commits del día y abre un issue.
# Con esto, por la mañana llega al móvil una notificación con dos botones —«Arreglarlo»
# y «No hacer nada»— y el primero lanza OTRA rutina que arregla los hallazgos, abre PR y
# lo mergea si el CI pasa. Necesita la migración 20260820_revision_hallazgos.
# Sin estas variables el issue se sigue abriendo igual: lo que no hay es aviso ni botón.
# Montaje completo en docs/REVISION_NOCTURNA.md.
REVISION_TOKEN=             # el mismo valor que el secret REVISION_TOKEN del repositorio,
                            # que es quien llama a /revision/hallazgos desde Actions
ARREGLO_FIRE_URL=           # trigger de API de la rutina que ARREGLA (otra distinta de
                            # la que revisa: aquella es de solo lectura a propósito)
ARREGLO_FIRE_TOKEN=         # sk-ant-oat01-... de esa rutina. Se enseña UNA vez

# ── Averías: arreglo automático y despliegue con permiso (opcional) ───────────
# El camino inverso al de arriba: cuando el CI se pone rojo en `main`, el backend lanza
# una sesión a arreglarlo SIN preguntar, y la pregunta llega después —al móvil y al
# teléfono— cuando hay un PR con el CI en verde esperando permiso para desplegarse.
# Necesita la migración 20260831_averias y las mismas rutinas de arriba.
# Nace APAGADO a propósito: enciende agentes que escriben código.
# Montaje completo en docs/AVERIAS.md.
AVERIA_CI=0                 # 1 para encender el arreglo automático del CI roto
AVERIA_MAX_INTENTOS=2       # arreglos seguidos del mismo origen antes de dejar de intentarlo
DEPLOY_GITHUB_TOKEN=        # PAT con contents/pull_requests/actions:write sobre el repo.
                            # Es la credencial más peligrosa de este fichero: con ella se
                            # mergea el PR y se dispara el deploy. Sin ella, el botón de
                            # desplegar lo DICE en vez de fallar en silencio

# La URL pública del dashboard. Solo la usa el botón «Hablarlo» del aviso de despliegue,
# que abre la pantalla de llamada para contestar hablando (el caso del coche). Vacía, el
# aviso conserva sus dos botones y lo único que se pierde es esa tercera vía.
FRONTEND_URL=               # https://tu-dashboard.vercel.app

# ── El teléfono: Jarvis te llama (opcional) ───────────────────────────────────
# Twilio llama a tu móvil y abre un WebSocket con el audio; al otro lado está el Jarvis
# de siempre, con sus herramientas. Es el único canal que no espera a que mires el móvil,
# y por eso solo llama lo que se queda BLOQUEADO hasta que contestes: hoy, el permiso de
# despliegue. Nace apagado: hace sonar un teléfono de pago.
LLAMADAS=0                  # 1 para encender las llamadas
TWILIO_ACCOUNT_SID=         # AC... de la consola de Twilio
TWILIO_AUTH_TOKEN=          # el Auth Token de esa misma cuenta. Firma los webhooks
TWILIO_NUMERO=              # el número DESDE el que llama Jarvis, en formato +34...
                            # No hace falta comprarlo: verifica tu propio móvil como
                            # "Verified Caller ID" en la consola de Twilio y ponlo aquí
                            # (la llamada aparece como si te llamaras tú mismo, y te
                            # ahorras la cuota mensual del número). Un número comprado
                            # también vale, si prefieres verlo identificado
TWILIO_MI_NUMERO=           # tu móvil, en formato +34... (puede ser el mismo de arriba)
BACKEND_URL=                # la URL pública de ESTE backend, para que Twilio vuelva.
                            # No se deduce de la petición: la llamada la empieza el backend
LLAMADA_TTL=300             # segundos que vale el contexto firmado de una llamada
LLAMADA_MAX_SEG=300         # tope duro de duración: una llamada colgada cobra por minuto
VOZ_SILENCIO_MS=800         # silencio que da por terminado tu turno al hablar
VOZ_UMBRAL_RMS=500          # por debajo de esta energía, un trozo de audio es silencio
VOZ_MIN_HABLA_MS=300        # menos que esto es una tos, no una frase

# ── Personalización de la instancia ───────────────────────────────────────────
TIMEZONE=Europe/Madrid      # zona horaria IANA del usuario
HOME_ADDRESS=               # origen por defecto para "¿a qué hora salir?" (tu dirección)
CLASSES_CALENDAR=clases     # nombre del calendario de clases en Outlook (vacío si no aplica)
CORS_ORIGINS=http://localhost:5173,https://TU-APP.vercel.app
WEATHER_LAT=40.4168         # coordenadas del widget de clima (Open-Meteo, sin API key)
WEATHER_LON=-3.7038         # por defecto Madrid — pon las tuyas
ALUD_ALLOWED_HOSTS=alud.deusto.es
                            # hosts (separados por comas) a los que se permite apuntar
                            # `alud_url`. Esa URL sale del cuerpo de un evento de Outlook
                            # y el agente la abre en un navegador CON SESIÓN INICIADA, así
                            # que solo se aceptan https y estos hosts (o sus subdominios).
                            # Pon el mismo valor en agent/.env.

# ── Opcionales ────────────────────────────────────────────────────────────────
# MAX_JOB_ATTEMPTS=3        # reintentos máximos de un job del agente PC
# PRESENCE_TTL_MINUTES=45   # cuánto vale la última ubicación que mandó HA (POST /ha/presencia).
#                           # Pasado ese plazo NO se usa para el clima ni la hora de salida:
#                           # dar el tiempo de donde estabas como si fuera el de donde estás
#                           # es peor que caer al default. Ponlo por encima del intervalo del
#                           # aviso periódico de HA, o el dato caducará entre avisos.
# PRESENCE_MAX_GAP_HOURS=3  # hueco máximo entre avisos que se sigue contando como tiempo en
#                           # esa zona (serie diaria time_at_home). Más que eso = HA estuvo
#                           # caído y no sabemos dónde estuviste: el tramo se descarta.
# LOGIN_MAX_ATTEMPTS=5      # rate limiting del login
# LOGIN_WINDOW_SECONDS=300
# LOGIN_BLOQUEO_MAX_SECONDS=3600   # techo del bloqueo progresivo (cada bloqueo dura el doble)
# HTTP_TIMEOUT=15           # segundos máx. por llamada saliente (Supabase, Graph, Maps)
# MAX_AUDIO_BYTES=8388608   # tope del audio de /ideas/audio (8 MB). Sin tope, el fichero
#                           # se carga entero en memoria y la VM tiene 1 GB.
# MAX_INGEST_BYTES=4194304  # tope del cuerpo de /health/ingest y /health/ingest/simple (4 MB)
# AUDIO_MAX_REQUESTS=10     # peticiones a /ideas/audio por IP y ventana: cada una es una
# AUDIO_WINDOW_SECONDS=300  # llamada de pago a Whisper
# TRUST_FORWARDED_FOR=      # ponlo a 1 SOLO si despliegas detrás de un proxy inverso
                            # propio que añada X-Forwarded-For. En Fly NO hace falta
                            # (ya manda Fly-Client-IP). Activarlo sin ese proxy delante
                            # permite falsificar la IP y saltarse el límite de intentos.
# HA_URL=                   # no lo usa el backend (HA sondea al backend, no al revés)
# HA_TOKEN=

# ── Registro persistente (tabla app_logs) ─────────────────────────────────────
# Los logger.error()/warning() del backend se guardan en Supabase además de salir por
# stdout, porque el stdout se va con la máquina de Fly cuando escala a cero. Se ven en
# ajustes → Estado del sistema → Registro.
# LOG_PERSIST=1             # ponlo a 0 para desactivarlo (solo stdout)
# LOG_PERSIST_LEVEL=WARNING # nivel mínimo que se persiste. INFO multiplica el volumen
#                           # y llena la tabla de ruido: sube a ERROR o baja con criterio
# LOG_QUEUE_MAX=500         # entradas encoladas en memoria como mucho. Al llenarse se
#                           # tiran las más viejas y se deja constancia de cuántas
# LOG_FLUSH_SECONDS=2       # cada cuánto vuelca el hilo de fondo
# LOG_RETENTION_DAYS=30     # se borra lo más viejo (una purga por arranque del proceso)
# LOG_SLOW_MS=8000          # a partir de aquí una petición se registra como lenta. Va
#                           # holgado: el arranque en frío de Fly ya se lleva segundos

# ── Jarvis (asistente conversacional) ─────────────────────────────────────────
# El chat con herramientas del dashboard (POST /jarvis). No necesita ninguna clave
# nueva: reutiliza OPENAI_API_KEY. Sin ella, /jarvis responde 503 igual que /ideas/*.
# Dos modelos: el pequeño habla y redacta, el grande decide qué herramienta usar y
# encadena pasos. La primera vuelta la tira el pequeño (acierta bien decidiendo SI hace
# falta una herramienta) y, si pide una, esa vuelta se relanza con el grande, que es
# quien elige de verdad. Una conversación que no toca nada no paga al grande ni una
# llamada. Poniendo los dos al mismo valor se desactiva el reparto.
# Precios por millón de tokens de entrada (agosto 2026). Medido contra la API: 3.667
# tokens de entrada por llamada con las 41 herramientas, de los que se cachean 3.456 (el
# esquema entra en el prefijo cacheable). La salida rara vez pasa de 200.
#   gpt-5-nano  $0.05   ·  gpt-4.1-nano $0.10  ·  gpt-4o-mini $0.15
#   gpt-5-mini  $0.25   ·  gpt-4.1-mini $0.40  ·  gpt-5 $1.25  ·  gpt-4o $2.50
# gpt-4o es de otra generación y cuesta DIEZ VECES más que gpt-5-mini: no lo pongas aquí
# por costumbre. La familia gpt-5 además cobra la entrada cacheada a una décima parte.
# JARVIS_MODEL=gpt-4o-mini        # el que habla (gpt-5-nano es 3x más barato aún)
# JARVIS_MODEL_ACCION=gpt-5-mini  # el que actúa: elige mucho mejor entre 41 herramientas
# JARVIS_MAX_VUELTAS=6      # vueltas del bucle herramienta→modelo. Cortacircuitos de
#                           # gasto: un modelo atascado pediría la misma sin avanzar
# JARVIS_MAX_HISTORIAL=10   # turnos de contexto. El historial viaja en cada petición,
#                           # así que es lo único que hace crecer el coste por turno.
#                           # Si lo bajas, baja también JARVIS_MAX_HISTORIAL en
#                           # src/lib/helpers.js o el cliente mandará más de lo que
#                           # acepta el backend y recibirá un 422 a media conversación
# JARVIS_MAX_MENSAJE=2000   # tope de caracteres de un mensaje
# JARVIS_MAX_TOKENS=400     # techo de la respuesta. Jarvis contesta corto por diseño
# JARVIS_MAX_TOKENS_VOZ=160 # y por voz, más corto: un párrafo que se lee en dos segundos
#                           # tarda medio minuto en escucharse, y no se pueden saltar líneas
# JARVIS_RESERVA_RAZONAMIENTO=2000
#                           # sitio para PENSAR, aparte del techo de la respuesta. Los
#                           # modelos de razonamiento (gpt-5*, o3, o4…) cobran su techo
#                           # contra lo que piensan MÁS lo que dicen: sin esta reserva se
#                           # lo gastan pensando y contestan vacío. Solo se paga si la usa
# JARVIS_MAX_REQUESTS=30    # peticiones por IP y ventana: cada turno es de pago
# JARVIS_WINDOW_SECONDS=300
# PC_AGENT_ID=pc-mikel      # el mismo valor que VITE_AGENT_ID en el frontend y que
#                           # AGENT_ID en agent/agent.py: identifica al PC en pc_agents
# JARVIS_REPO=usuario/repo  # dónde vive este proyecto. Con un servidor MCP de GitHub
#                           # conectado, es lo que le permite a Jarvis proponer mejoras de
#                           # su propio código abriendo un issue. Vacío = no lo hace

# ── Jarvis: acceso a internet ─────────────────────────────────────────────────
# Herramientas `buscar_en_internet` y `leer_pagina`. Leer una página no necesita clave;
# BUSCAR sí en la práctica: a agosto de 2026 DuckDuckGo responde con captcha a las
# peticiones automatizadas (comprobado, también desde IP doméstica), así que sin una de
# estas dos claves la búsqueda devolverá un error que lo explica.
# TAVILY_API_KEY=           # recomendada: 1.000 búsquedas/mes gratis y sin tarjeta
# BRAVE_API_KEY=            # alternativa: su tier gratuito murió en feb-2026, ahora son
#                           # 5 $/mes de crédito (~1.000 búsquedas)
# JARVIS_WEB=1              # ponlo a 0 para dejar a Jarvis sin internet
# JARVIS_WEB_RESULTADOS=5   # resultados por búsqueda (1-10)
# JARVIS_WEB_MAX_BYTES=512000   # tope de descarga de una página (protege la memoria)
# JARVIS_WEB_MAX_TEXTO=6000     # tope del texto que entra al prompt (protege la factura)

# ── Jarvis: memoria persistente ───────────────────────────────────────────────
# Herramientas `recordar`/`olvidar` sobre la tabla jarvis_memoria (migración
# 20260807_jarvis_memoria.sql). No necesita variables: funciona en cuanto la tabla
# existe. Los recuerdos se inyectan en el prompt de cada turno y se pagan por token —
# de ahí los dos topes.
# JARVIS_MAX_RECUERDOS=60   # cuántos recuerdos entran en el prompt (los más recientes)
# JARVIS_RECUERDO_MAX=400   # tope de caracteres de cada recuerdo

# ── Jarvis: servidores MCP ────────────────────────────────────────────────────
# Lista blanca de servidores MCP (Streamable HTTP) que Jarvis puede usar. La decides
# TÚ aquí; el modelo solo elige entre los que apruebes — nunca añade uno. JSON:
#   {"nombre": {"url": "https://...", "token": "...", "confiar": false, "lectura_directa": true}}
#
# Qué se ejecuta solo y qué te pregunta, de más a menos permisivo:
#   confiar=true          → todo directo, sin preguntar. Solo para servidores inocuos.
#   lectura_directa=true  → (POR DEFECTO) las herramientas que el servidor marca de solo
#                           lectura se ejecutan al momento; lo que escribe, borra o
#                           publica se propone y lo apruebas con un botón en el chat.
#   lectura_directa=false → absolutamente todo pasa por el botón. Ojo: así Jarvis no
#                           puede reintentar cuando se equivoca de herramienta, porque
#                           la propuesta corta su bucle — con servidores grandes acierta
#                           bastante menos.
#
# Ejemplo real (GitHub; el token es un PAT tuyo o el de `gh auth token`):
#   JARVIS_MCP_SERVERS={"github":{"url":"https://api.githubcopilot.com/mcp/","token":"ghp_..."}}
# JARVIS_MCP_SERVERS=
# JARVIS_MCP_MAX_TEXTO=6000  # tope del resultado que entra al prompt
#
# Esta variable ya no es la única vía: Jarvis puede PROPONER conectar un servidor
# (`mcp_conectar`) y, si lo apruebas con el botón del dashboard, se guarda en la tabla
# jarvis_mcp_servidores sin redesplegar nada. La regla no cambia —el alta la aprueba una
# persona, nunca el modelo— y lo que pongas aquí manda sobre lo dado de alta así.

# ── Casa (Home Assistant) ─────────────────────────────────────────────────────
# Jarvis puede encender luces y demás. El backend no llega a HA (vive en tu LAN), así que
# HA sondea GET /ha/ordenes-pending y empuja su catálogo a POST /ha/entidades, las dos con
# HA_POLL_TOKEN. El YAML está en docs/HOME_ASSISTANT_JARVIS.md.
# CASA_ORDEN_TTL=300         # segundos que vive una orden sin recoger. Si HA estuvo caído,
#                            # al volver no puede encender lo que pediste hace horas

# ── Finanzas (Indexa Capital) ─────────────────────────────────────────────────
# Token de lectura de tu cuenta de Indexa: se crea en la web, en
# "Configuración de usuario → Aplicaciones". Solo aquí, NUNCA en el frontend: abre la
# cuenta entera y el navegador es público. Sin esta variable el widget dice que no está
# conectado, que no es lo mismo que fallar.
# INDEXA_TOKEN=
# INDEXA_API_URL=https://api.indexacapital.com   # solo para pruebas
# INDEXA_CUENTAS=            # filtro opcional de nº de cuenta, separados por comas
# INDEXA_TTL_MINUTOS=180     # Indexa valora una vez al día: no hace falta preguntar más
# INDEXA_SERIE_DIAS=365      # días de serie que se mandan al dashboard

# ── Finanzas (Enable Banking — Revolut) ───────────────────────────────────────
# Agregador PSD2. Registra la app en https://enablebanking.com/cp — al crearla, el
# navegador descarga una clave privada RSA que Enable Banking NO vuelve a enseñar:
# guárdala fuera de Descargas. La conexión es un consentimiento OAuth (como Outlook),
# no un token fijo: /auth/enablebanking/login la inicia, caduca a los
# ENABLE_BANKING_VALID_DIAS días y hay que repetirla, no se renueva sola.
# ENABLE_BANKING_APPLICATION_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=  # ruta al .pem descargado al registrar la app
# ENABLE_BANKING_API_URL=https://api.enablebanking.com
# ENABLE_BANKING_ASPSP_NAME=Revolut
# ENABLE_BANKING_ASPSP_COUNTRY=ES
# ENABLE_BANKING_REDIRECT_URL=      # debe estar en las "Redirect URLs" de la app;
#                                   # apunta al BACKEND (…/auth/enablebanking/callback),
#                                   # no al frontend
# ENABLE_BANKING_VALID_DIAS=180

# ── Finanzas: cartera manual de ETFs (Yahoo Finance) ──────────────────────────
# Ningún agregador PSD2 puede leer la cartera de inversión de Revolut (PSD2 solo
# cubre cuentas de pago), así que se lleva a mano y el precio de cada ETF se saca del
# endpoint de gráficas de Yahoo Finance — no oficial, pero gratis y sin clave. No hay
# nada que configurar aquí; estas dos son solo para pruebas o para cambiar el TTL.
# YAHOO_FINANCE_API_URL=https://query1.finance.yahoo.com
# ETF_PRECIO_TTL_MINUTOS=60

# ── Jarvis: voz en tiempo real (ElevenLabs) ───────────────────────────────────
# Apagado por defecto. Sin encender esto, el modo llamada sigue usando la voz y el
# reconocimiento del propio navegador (Web Speech), que son gratis. Ver
# docs/JARVIS_VOZ.md antes de tocar nada de aquí.
#
# La clave NUNCA va al frontend: no la pongas como VITE_*, acabaría en el bundle
# público de Vercel. El navegador habla con ElevenLabs con un token de un solo uso que
# emite /voz/token. Créala en el panel de ElevenLabs con permisos SOLO de Text to Speech
# y Speech to Text; si además le pones un límite de créditos, mejor.
# JARVIS_VOZ_ELEVENLABS=1
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=              # el id de la voz en "My Voices" (no es secreto)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Formato del audio de vuelta. PCM permite cortar a Jarvis al instante al interrumpirle,
# pero está restringido por plan; con MP3 queda una coleta de audio al cortar. Sube esto
# a pcm_24000 cuando la cuenta lo permita.
# ELEVENLABS_FORMATO=mp3_44100_128
# Por voz se abre directamente con JARVIS_MODEL_ACCION en vez de empezar por el
# pequeño y relanzar: el relevo cuesta una llamada entera al modelo, que hablando son
# un par de segundos de silencio antes de la primera sílaba. Con 0 vuelve el reparto.
# JARVIS_VOZ_MODELO_DIRECTO=1
# El reconocimiento se cobra por MICRÓFONO ABIERTO, no por palabras dichas: una llamada
# olvidada abierta es dinero corriendo. Esto la cuelga sola.
# JARVIS_VOZ_MAX_MINUTOS=20
# VOZ_TOKEN_MAX_REQUESTS=60
# VOZ_TOKEN_WINDOW_SECONDS=300
